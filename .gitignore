# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Big Data assignment rules:
# Jangan commit dataset mentah atau hasil olahan berukuran besar ke Git
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Ignore large archives & data formats
*.parquet
*.csv
*.tsv
*.tar.gz
*.bz2
*.zip
*.duckdb

# Docker / local logs
*.log
